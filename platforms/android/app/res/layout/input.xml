<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <ImageButton
            android:id="@+id/keyboard_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/reading_chip"
            android:padding="14dp"
            android:src="@drawable/tacit_logo"
            android:scaleType="fitCenter"
            android:contentDescription="@string/input_mode" />

        <ImageButton android:id="@+id/paste_tool" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:minWidth="48dp"
            android:background="@drawable/reading_chip" android:padding="12dp"
            android:src="@drawable/ic_clipboard_paste" android:contentDescription="@string/paste"
            android:tooltipText="@string/paste" />
        <ImageButton android:id="@+id/clipboard_tool" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:minWidth="48dp"
            android:background="@drawable/reading_chip" android:padding="12dp"
            android:src="@drawable/ic_clipboard" android:contentDescription="@string/clipboard"
            android:tooltipText="@string/clipboard" />
        <ImageButton android:id="@+id/emoji_tool" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:minWidth="48dp"
            android:background="@drawable/reading_chip" android:padding="12dp"
            android:src="@drawable/ic_smile" android:contentDescription="@string/emoji"
            android:tooltipText="@string/emoji" />
        <ImageButton android:id="@+id/more_tool" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:minWidth="48dp"
            android:background="@drawable/reading_chip" android:padding="12dp"
            android:src="@drawable/ic_ellipsis" android:contentDescription="@string/keyboard_settings"
            android:tooltipText="@string/keyboard_settings" />
        <ImageButton android:id="@+id/tools_toggle" android:layout_width="48dp"
            android:layout_height="48dp" android:background="@drawable/reading_chip"
            android:padding="12dp" android:src="@drawable/ic_chevron_down"
            android:contentDescription="@string/hide_keyboard" />
    </LinearLayout>

    <HorizontalScrollView android:id="@+id/readings_scroll"
        android:layout_width="match_parent" android:layout_height="40dp"
        android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:id="@+id/readings" android:layout_width="wrap_content"
            android:layout_height="match_parent" android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/keyboard" />

        <LinearLayout
            android:id="@+id/clipboard_panel"
            android:layout_width="match_parent"
            android:layout_height="236dp"
            android:background="@color/keyboard_background"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/clipboard"
                    android:textColor="@color/keyboard_text"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium" />
                <Button
                    android:id="@+id/clipboard_close"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/reading_chip"
                    android:drawableLeft="@drawable/ic_keyboard"
                    android:drawablePadding="8dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="@string/back_to_keyboard"
                    android:textAllCaps="false"
                    android:textColor="@color/keyboard_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/clipboard_preview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/keyboard_key"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="3"
                android:padding="14dp"
                android:textColor="@color/keyboard_text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/clipboard_paste"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/clipboard_action"
                android:drawableLeft="@drawable/ic_clipboard_paste"
                android:drawablePadding="8dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="@string/paste"
                android:textAllCaps="false"
                android:textColor="@color/keyboard_text"
                android:textSize="16sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="6dp"
                android:text="@string/clipboard_no_history"
                android:textColor="@color/keyboard_hint"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/emoji_panel" android:layout_width="match_parent"
            android:layout_height="228dp" android:background="@color/keyboard_background"
            android:orientation="vertical" android:padding="8dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="32dp"
                android:gravity="center_vertical" android:paddingLeft="12dp"
                android:text="@string/emoji" android:textSize="16sp"
                android:textColor="@color/keyboard_text" />
            <LinearLayout android:id="@+id/emoji_rows" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
        </LinearLayout>
        <include layout="@layout/settings" />
    </FrameLayout>
</LinearLayout>
