<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="3dp" android:insetRight="3dp"
    android:insetTop="4dp" android:insetBottom="4dp">
    <selector>
        <item android:state_selected="true">
            <layer-list>
                <item>
                    <shape>
                        <solid android:color="@color/keyboard_pressed" />
                        <corners android:radius="9dp" />
                    </shape>
                </item>
                <item android:height="2dp" android:gravity="bottom" android:left="12dp" android:right="12dp" android:bottom="5dp">
                    <shape><solid android:color="@color/keyboard_accent" /></shape>
                </item>
            </layer-list>
        </item>
        <item android:state_pressed="true">
            <shape>
                <solid android:color="@color/keyboard_pressed" />
                <corners android:radius="9dp" />
            </shape>
        </item>
        <item>
            <shape>
                <solid android:color="@android:color/transparent" />
                <corners android:radius="9dp" />
            </shape>
        </item>
    </selector>
</inset>
